{
  "name": "rdevtool",
  "private": true,
  "version": "0.1.6",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "prebuild": "npm run clean:build-cache",
    "build": "node ./scripts/build-release.mjs",
    "release:artifacts": "node ./scripts/collect-release-artifacts.mjs",
    "cli": "cargo run --quiet --",
    "cli:json": "cargo run --quiet -- --json",
    "cli:install": "sh ./scripts/install-cli.sh",
    "docs:screenshots": "npm --prefix web run docs:screenshots",
    "prepare:cli-sidecar": "node ./scripts/prepare-cli-sidecar.mjs",
    "manifest:check": "node ./scripts/validate-app-manifest.mjs",
    "manifest:check:json": "node ./scripts/validate-app-manifest.mjs --json",
    "release:check": "node ./scripts/release-preflight.mjs",
    "ipc:check": "node ./scripts/check-ipc-contract.mjs",
    "ipc:check:json": "node ./scripts/check-ipc-contract.mjs --json",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test",
    "web:test:e2e": "npm --prefix web run test:e2e",
    "icons": "python3 ./scripts/generate-icons.py && cd src-tauri && ../web/node_modules/.bin/tauri icon icons/rdevtool-app-icon-source.png && cd .. && python3 ./scripts/generate-icons.py --post-export && cp src-tauri/icons/128x128.png web/public/rdevtool.png",
    "rust-check": "cargo check --locked --manifest-path ./src-tauri/Cargo.toml",
    "prerust-check": "npm run prepare:cli-sidecar",
    "rust-test": "cargo test --locked --quiet && cargo test --locked --quiet --manifest-path ./src-tauri/Cargo.toml",
    "prerust-test": "npm run prepare:cli-sidecar",
    "check": "npm run manifest:check && npm run ipc:check && npm run web:test && npm run web:build && npm run rust-test && npm run rust-check",
    "check:full": "npm run check && npm run web:test:e2e",
    "size": "du -sh ./target ./web/node_modules ./web/dist 2>/dev/null || true",
    "clean:build-cache": "node ./scripts/clean.mjs build-cache",
    "clean": "node ./scripts/clean.mjs standard",
    "clean:all": "node ./scripts/clean.mjs all"
  }
}
